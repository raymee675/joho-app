{
  "compilerOptions": {
    "target": "ES2020", "lib": ["ES2020", "DOM", "DOM.Iterable"], "module": "ESNext",
    "moduleResolution": "bundler", "jsx": "react-jsx", "strict": true, "skipLibCheck": true,
    "resolveJsonModule": true, "noEmit": true, "isolatedModules": true,
    "types": ["vite/client", "vite-plugin-pwa/client", "vitest/globals", "node"],
    "paths": { "@deck": ["./sample/deck.json"] }
  },
  "include": ["src", "tests", "vite.config.ts"]
}
